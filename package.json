{
  "name": "video-download-merge-studio-pro",
  "version": "1.3.7",
  "description": "Tubmedia — trung tâm tải, quản lý hàng đợi và chuẩn bị video cho editor với giao diện Studio.",
  "main": "./out/main/index.js",
  "author": "Đình Duy Tubmedia",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:electron": "install-electron",
    "dev": "npm run prepare:electron && npm run tools:prepare-dev:windows && electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ignore-pattern \".tubmedia-patches/**\" --ignore-pattern \"vendor/**/*.d.ts\" --max-warnings=0",
    "check:assets": "node scripts/validate-assets.mjs",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run dist:official",
    "dist:dir": "npm run prepare:electron && npm run build && electron-builder --dir",
    "rebuild": "node scripts/no-native-rebuild.mjs",
    "check": "npm run verify:version && npm run verify:timeline-merge-recovery && npm run verify:merge-visual-boundary && npm run verify:adaptive-settings && npm run verify:hdr-capcut && npm run verify:source-completeness && npm run check:assets && npm run verify:release && npm run verify:stable && npm run verify:audit-hardening && npm run verify:core-resilience && npm run verify:download-recovery && npm run verify:youtube-source-removed-r36 && npm run verify:youtube-url-validation-r34 && npm run verify:download-stall-recovery && npm run verify:pause-project-race && npm run verify:pause-terminal-noop && npm run verify:r18-adaptive-batch && npm run verify:notification-cookie-upgrade && npm run verify:notification-cookie-action && npm run verify:audit-behavior && npm run verify:quick-download && npm run verify:video-link-filter && npm run verify:editor-workflows && npm run verify:duration-persistence && npm run verify:tool-update-rate-limit && npm run verify:cleanup-ui && npm run verify:system-cleanup && npm run verify:startup-update-awareness && npm run verify:update-notification-ux && npm run verify:update-check-nonblocking && npm run verify:professional-passive-update-center && npm run verify:professional-update-now && npm run verify:bundled-aria2 && npm run verify:differential-updater && npm run verify:unified-app-updater && npm run verify:pre132-user-release && npm run verify:safe-zip-extraction && npm run verify:js-yaml-security && npm run verify:updater-metadata && npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build && npm run test:e2e",
    "doctor:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor-windows.ps1",
    "tools:check:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tools-windows.ps1 -Mode check",
    "tools:repair:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tools-windows.ps1 -Mode repair",
    "tools:update:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tools-windows.ps1 -Mode update",
    "dist:electron-builder": "npm run prepare:electron && npm run build && electron-builder --win nsis --x64",
    "dist:nsis-safe": "npm run prepare:aria2 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer-windows.ps1 && node scripts/generate-installer-blockmap.mjs && node scripts/write-updater-metadata-utf8nobom.mjs",
    "dist:source-update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-source-update.ps1",
    "bump": "node scripts/bump-version.mjs",
    "verify:version": "node scripts/verify-version-consistency.mjs",
    "verify:v0100": "node scripts/verify-v0100.mjs",
    "verify:v0101": "node scripts/verify-v0101.mjs",
    "verify:release": "node scripts/verify-release-candidate.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release-windows.ps1",
    "release:manifest": "node scripts/create-release-config.mjs",
    "dist:legacy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer-windows.ps1",
    "tools:repair-required:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tools-windows.ps1 -Mode repair-required",
    "tools:prepare-dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tools-windows.ps1 -Mode repair-required -SoftFail",
    "verify:stable": "node scripts/verify-stable-release.mjs",
    "dist:official": "powershell -NoProfile -ExecutionPolicy Bypass -File BUILD_INSTALLER_CHINH_THUC.ps1",
    "verify:audit-hardening": "node scripts/verify-audit-hardening.mjs",
    "verify:audit-behavior": "node --experimental-strip-types scripts/verify-audit-behavior.mjs",
    "format:check": "prettier --check .",
    "verify:gate-fixes": "node scripts/verify-validation-gate-fixes.mjs",
    "verify:recovery-upgrade": "node --experimental-strip-types scripts/verify-recovery-upgrade.mjs",
    "verify:notification-cookie-upgrade": "node scripts/verify-notification-cookie-upgrade.mjs",
    "verify:runtime-recovery-upgrade": "node scripts/verify-runtime-recovery-upgrade.mjs",
    "verify:update-center-ui": "node scripts/verify-update-center-ui.mjs",
    "verify:system-cleanup": "node scripts/verify-system-cleanup-integration.mjs",
    "verify:quick-download": "node scripts/verify-quick-download-integration.mjs",
    "verify:cleanup-ui": "node scripts/verify-cleanup-navigation-ui.mjs",
    "verify:tool-update-rate-limit": "node scripts/verify-tool-update-rate-limit.mjs",
    "verify:duration-persistence": "node scripts/verify-duration-persistence.mjs",
    "verify:source-completeness": "node scripts/verify-source-completeness.mjs",
    "verify:editor-workflows": "node scripts/verify-editor-workflows-1.3.0.mjs",
    "verify:core-resilience": "node scripts/verify-core-resilience-1.3.0.mjs",
    "verify:video-link-filter": "node scripts/verify-video-link-filter.mjs",
    "verify:download-recovery": "node scripts/verify-download-recovery-r49.mjs",
    "verify:hdr-capcut": "node scripts/verify-hdr-capcut-hotfix7.mjs",
    "verify:adaptive-settings": "node scripts/verify-adaptive-settings-hotfix8.mjs",
    "verify:merge-visual-boundary": "node scripts/verify-merge-visual-boundary-hotfix11.mjs",
    "verify:timeline-merge-recovery": "node scripts/verify-timeline-merge-recovery-hotfix12.mjs",
    "verify:startup-update-awareness": "node scripts/verify-startup-update-awareness-hotfix14.mjs",
    "verify:unified-app-updater": "node scripts/verify-unified-app-updater-hotfix15.mjs",
    "verify:pre132-user-release": "node scripts/verify-pre132-user-release.mjs",
    "verify:safe-zip-extraction": "node scripts/verify-safe-zip-extraction-pre132.mjs",
    "verify:js-yaml-security": "node scripts/verify-js-yaml-security-pre132.mjs",
    "verify:updater-metadata": "node scripts/verify-updater-metadata-encoding-pre132.mjs",
    "verify:update-notification-ux": "node scripts/verify-update-notification-ux-pre132.mjs",
    "verify:r18-adaptive-batch": "node scripts/verify-r18-adaptive-download-batch-errors.mjs",
    "verify:pause-project-race": "node scripts/verify-pause-project-race-v132.mjs",
    "verify:pause-terminal-noop": "node scripts/verify-pause-terminal-noop-hotfix-v132.mjs",
    "verify:update-check-nonblocking": "node scripts/verify-update-check-nonblocking-hotfix-v132.mjs",
    "verify:professional-update-now": "node scripts/verify-professional-update-now-v132.mjs",
    "verify:download-stall-recovery": "node scripts/verify-download-stall-recovery-v132.mjs",
    "verify:differential-updater": "node scripts/verify-differential-updater-v133.mjs",
    "prepare:aria2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-bundled-aria2.ps1",
    "verify:bundled-aria2": "node scripts/verify-bundled-aria2-v133.mjs",
    "verify:professional-passive-update-center": "node scripts/verify-professional-passive-update-center-v133.mjs",
    "verify:notification-cookie-action": "node scripts/verify-notification-cookie-action-r31n.mjs",
    "verify:youtube-url-validation-r34": "node scripts/verify-youtube-url-validation-r34.mjs",
    "verify:youtube-source-removed-r36": "node scripts/verify-youtube-source-removed-r36.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tubmedia/safe-extract-zip": "file:vendor/safe-extract-zip",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.62.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "app-builder-bin": "5.0.0-alpha.12",
    "electron": "43.2.0",
    "electron-builder": "26.15.4",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.7",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.tubmedia.download-video",
    "productName": "Download video Tubmedia",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tool",
        "to": "tool",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "perMachine": false,
      "differentialPackage": true,
      "packElevateHelper": true,
      "shortcutName": "Download video Tubmedia",
      "uninstallDisplayName": "Download video Tubmedia",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "include": "installer/electron-builder-upgrade.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dinhduy2702",
        "repo": "Dinh-Duy-Tubmedia",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "compression": "normal",
    "removePackageScripts": true
  },
  "overrides": {
    "js-yaml": "5.2.3"
  }
}
